# Copy to .env and replace the placeholders. Never commit .env.
# Local PostgreSQL 18, app role "kinemax" (not a superuser).
DATABASE_URL=postgresql://kinemax:CHANGE_ME@127.0.0.1:5432/kinemax?schema=public
# Used by integration and e2e tests only. The database name must end in "_test".
DATABASE_URL_TEST=postgresql://kinemax:CHANGE_ME@127.0.0.1:5432/kinemax_test?schema=public
HOST=127.0.0.1
PORT=3001
# Comma-separated list of extra allowed cross-origin origins. Leave empty: the web app is same-origin.
CORS_ALLOWED_ORIGINS=
