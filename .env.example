# Copy to .env and replace the placeholders. Never commit .env.
# Local PostgreSQL 18, app role "kinemax" (not a superuser).
DATABASE_URL=postgresql://kinemax:CHANGE_ME@127.0.0.1:5432/kinemax?schema=public
# Used by integration and e2e tests only. The database name must end in "_test".
DATABASE_URL_TEST=postgresql://kinemax:CHANGE_ME@127.0.0.1:5432/kinemax_test?schema=public
HOST=127.0.0.1
PORT=3001
# Comma-separated list of extra allowed cross-origin origins. Leave empty: the web app is same-origin.
CORS_ALLOWED_ORIGINS=
# Auth (see docs/auth.md). Development defaults apply while these stay commented out.
# Origin the web app is served from; state-changing requests must come from it (https in production).
# APP_ORIGIN=http://localhost:5180
# Secure __Host- cookies; defaults to true in production and cannot be false there.
# COOKIE_SECURE=false
# HMAC key for CSRF tokens, 32+ random characters. Required in production.
# CSRF_SECRET=CHANGE_ME_TO_32_PLUS_RANDOM_CHARACTERS
# Number of reverse proxies in front of the API (0 = none).
# TRUST_PROXY=0
# Directory for uploaded movie images (outside the web build). Default: uploads/ in the repository.
# Required in production.
# UPLOADS_DIR=
# The built web app to serve from the API (production, see docs/deployment.md). Unset: API only.
# WEB_DIST_DIR=apps/web/dist
# Dev-only demo user passwords for `npm run db:seed`. Leave empty: the seed generates random ones.
SEED_SUPER_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_CUSTOMER_PASSWORD=
