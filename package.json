{
  "name": "kinemax",
  "version": "0.1.0",
  "private": true,
  "description": "Kinemax: a fictional premium multi-location cinema website (personal portfolio project).",
  "type": "module",
  "engines": {
    "node": ">=22.22.0",
    "npm": ">=11.16.0"
  },
  "workspaces": [
    "packages/shared",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently --names api,web --prefix-colors red,white --kill-others-on-fail \"npm run dev -w @kinemax/api\" \"npm run dev -w @kinemax/web\"",
    "db:migrate": "npm run db:migrate -w @kinemax/api",
    "db:seed": "npm run db:seed -w @kinemax/api",
    "db:studio": "npm run db:studio -w @kinemax/api",
    "db:reset": "npm run db:reset -w @kinemax/api",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces && tsc -p tsconfig.json",
    "test": "npm run test --workspaces && vitest run",
    "test:cov": "npm run test:cov --workspaces && vitest run --coverage",
    "build": "npm run build -w @kinemax/shared && npm run build -w @kinemax/api && npm run build -w @kinemax/web",
    "e2e": "npm run build && npm run e2e:run",
    "e2e:run": "playwright test",
    "audit": "node scripts/audit-gate.ts",
    "audit:dev": "npm audit || exit 0",
    "verify": "npm run lint && npm run typecheck && npm run test:cov && npm run build && npm run e2e:run && npm run audit"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.1",
    "@vitest/coverage-v8": "5.0.3",
    "concurrently": "10.0.6",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": true,
    "esbuild@0.28.2": true,
    "argon2@0.45.1": true,
    "fsevents": false
  }
}
