{
  "name": "@kinemax/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Zod schemas and types shared by the Kinemax web app and API.",
  "type": "module",
  "exports": {
    ".": {
      "kinemax-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "4.6.5"
  }
}
