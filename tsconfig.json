{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    // scripts/*.ts run directly with Node's built-in type stripping.
    "erasableSyntaxOnly": true,
    "noEmit": true
  },
  "include": ["playwright.config.ts", "vitest.config.ts", "e2e", "scripts"]
}
