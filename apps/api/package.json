{
  "name": "@kinemax/api",
  "version": "0.1.0",
  "private": true,
  "description": "Kinemax API: Express 5 + Prisma + PostgreSQL.",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "generate": "prisma generate",
    "dev": "node --watch --import tsx --conditions=kinemax-source src/server.ts",
    "start": "node dist/server.js",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:seed": "prisma db seed",
    "e2e:catalog": "tsx scripts/e2e-catalog.ts",
    "e2e:hold-minutes": "tsx scripts/e2e-hold-minutes.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "cors": "2.8.6",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "prisma": "7.10.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15"
  }
}
